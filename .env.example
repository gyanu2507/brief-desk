# Free default: Groq (OpenAI-compatible). Get a key at https://console.groq.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
COPILOTKIT_AGENT_MODEL=openai:llama-3.3-70b-versatile

# Streamable HTTP MCP server (npm run dev:mcp)
MCP_URL=http://127.0.0.1:3108/mcp
MCP_PORT=3108

# Optional: live GitHub briefing
BRIEF_SOURCE=fixture
BRIEF_REPO=
GITHUB_TOKEN=

COPILOTKIT_TELEMETRY_DISABLED=true

OPENAI_API_KEY=

# openai | anthropic | google — e.g. openai:gpt-4o-mini
COPILOTKIT_AGENT_MODEL=openai:gpt-4o-mini

# Streamable HTTP MCP server (started by npm run dev:mcp)
MCP_URL=http://127.0.0.1:3108/mcp
MCP_PORT=3108

# Optional: point tools at a live GitHub repo (requires GITHUB_TOKEN for private/rate limits)
BRIEF_SOURCE=fixture
BRIEF_REPO=
GITHUB_TOKEN=

# Free default: Groq (OpenAI-compatible). Get a key at https://console.groq.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
COPILOTKIT_AGENT_MODEL=openai:qwen/qwen3.8-27b
# Optional override for /api/brief-run drafting only
# BRIEF_RUN_MODEL=qwen/qwen3.8-27b

# Streamable HTTP MCP server (Python: npm run dev:mcp)
MCP_URL=http://127.0.0.1:3108/mcp
MCP_PORT=3108
# HOST=0.0.0.0
# Extra Host headers allowed by the MCP DNS-rebinding guard (comma-separated)
# MCP_ALLOWED_HOSTS=my-mcp.example.com

# GitHub (set on the MCP host / Render). Leave BRIEF_ALLOWED_REPOS unset so any repo works.
# UI passes owner/name per request; BRIEF_REPO is only a server-side default.
# GITHUB_TOKEN is required for code search (brief_repo_ask); strongly recommended otherwise.
BRIEF_SOURCE=fixture
BRIEF_REPO=
GITHUB_TOKEN=
# BRIEF_ALLOWED_REPOS=

# brief_web_search uses DuckDuckGo Instant Answer (no key). Optional GITHUB_TOKEN above still helps repo tools.

COPILOTKIT_TELEMETRY_DISABLED=true

# Optional: Supabase Auth (GitHub) + history/saved sync.
# Create a free project, run supabase/schema.sql, enable GitHub provider.
# Leave blank to keep guest-only localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

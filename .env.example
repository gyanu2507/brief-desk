# Free default: Groq (OpenAI-compatible). Get a key at https://console.groq.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
COPILOTKIT_AGENT_MODEL=openai:openai/gpt-oss-20b

# Streamable HTTP MCP server (npm run dev:mcp)
MCP_URL=http://127.0.0.1:3108/mcp
MCP_PORT=3108

# GitHub (set on the MCP host / Render). Leave BRIEF_ALLOWED_REPOS unset so any repo works.
# UI passes owner/name per request; BRIEF_REPO is only a server-side default.
BRIEF_SOURCE=fixture
BRIEF_REPO=
GITHUB_TOKEN=
# BRIEF_ALLOWED_REPOS=

COPILOTKIT_TELEMETRY_DISABLED=true
